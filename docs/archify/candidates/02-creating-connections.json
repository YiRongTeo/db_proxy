    { "dot": "cyan", "title": "Two halves of one promise", "items": ["API half: control plane mints the token — authorization for one connection", "Wire half: DB client connects to :3306 with the token as username", "The session exists (status=pending) from the moment the token is issued"] },
    { "dot": "emerald", "title": "Checker-first flow", "items": ["A checker can select and watch the session before the maker connects", "watch:<sid> is armed via the checker hub, heartbeat-refreshed", "This ordering is what resolves the maker/checker deadlock"] },
    { "dot": "rose", "title": "Zero-trust at the wire", "items": ["GETDEL consumes the token atomically — a second connect is rejected", "Real credentials are resolved inside the data plane, memory-only", "The maker's client only ever sees its token"] }
