  "cards": [
    { "dot": "rose", "title": "The rule", "items": ["access=write sessions cannot execute SQL without a watching checker", "Enforced inside the data plane, per command, before any byte is forwarded", "Read-only makers are never gated"] },
    { "dot": "cyan", "title": "Grace + re-open", "items": ["Unwatched commands are held for gate_wait_seconds (default 20, 0 = reject)", "A checker arriving in the window unblocks held commands, in order", "No permanent latch — a returning checker re-opens the gate"] },
    { "dot": "amber", "title": "Separation of duties", "items": ["The watcher cannot be the session's maker — WS attach is identity-checked", "Same user → 1008 policy-violation close, no watch:<sid> lease", "Unknown/expired session record → fail-closed, rejected the same way"] }
