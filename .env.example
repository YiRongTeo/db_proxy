# Copy to .env (git-ignored) and adjust:  cp .env.example .env
# The planes load this file on startup (config.LoadDotEnv) and the existing
# ZT_* env-override machinery resolves these exactly like exported vars.
# Process env wins over .env. Missing/empty required secrets fail fast at
# plane startup — never silently.

# --- Control Plane auth (configs/control.yaml auth.*) ---
# JWT/roles model (2026-09-05 conversion): /api/login self-issues a bearer
# JWT; every authenticated route takes "Authorization: Bearer <jwt>". Roles
# (maker|checker) and auth.allow_maker_watch live in configs/control.yaml,
# NOT here. ZT_API_API_KEY was REMOVED in the conversion (control-plane
# X-Api-Key retired) — delete it from any pre-existing .env file; setting it
# has no effect.
# ZT_AUTH_USERNAME is optional (the config keeps the username); the
# password is REQUIRED when auth.jwt.login_enabled is true — empty = the
# control plane refuses to start. Not required in external-JWT-only mode
# (auth.jwt.login_enabled: false).
ZT_AUTH_USERNAME=admin
ZT_AUTH_PASSWORD=admin123

# JWT signing secret (configs/control.yaml auth.jwt.secret) — REQUIRED
# when auth.jwt.login_enabled: true (empty/unset = the control plane
# refuses to start). HS256: use a long random value (32+ bytes).
# Env override (viper): ZT_AUTH_JWT_SECRET also works.
ZT_JWT_SECRET=change-me-to-a-long-random-string-0123456789
# External-issuer shared secrets (configs/control.yaml
# auth.jwt.external_issuers[].secret, Phase 2 Task 1) — required ONLY when
# an external_issuers entry is ACTIVE. The committed example block is
# commented out until the other app's issuer is live, so this stays
# commented too. HS256: use a long random value (32+ bytes).
# The entry's OTHER settings live in control.yaml, not here: per-entry
# audience (empty = inherit auth.jwt.audience), require_jti (ABSENT = true:
# their tokens MUST carry a jti or the plane 401s them — the logout
# denylist keys on jti, so an external token without one could never be
# revoked), and the claims map (subject/role claim NAMES + role_aliases) if
# their JWT uses different claim names than sub/role — adapt in yaml, never
# in code.
# ZT_OTHERAPP_JWT_SECRET=change-me-to-another-long-random-string-0123456789
# NOTE: auth.jwt.allowed_origins — since Phase 2 Task 3 ONE cross-origin
# allowlist governs BOTH the REST CORS surface (the other app's browser UI
# calling /api/* with a bearer JWT) and the checker WebSocket (/ws/checker)
# upgrade. Prefix an entry with https:// to pin the scheme; the port is part
# of the matched host, so a UI served on a non-default port must include it
# (e.g. https://other-app.example:8443). No dedicated env binding, but
# AutomaticEnv still maps ZT_AUTH_JWT_ALLOWED_ORIGINS (comma-separated) if
# set; the list lives in configs/control.yaml (default empty = same-origin
# only).

# Optional extra UI users (configs/control.yaml auth.users) — e.g. a
# dedicated checker account for SoD maker/checker testing. REQUIRED when
# the user is listed; empty = the control plane refuses to start.
ZT_AUTH_CHECKER_PASSWORD=checker123

# --- Session audit sink (configs/control.yaml audit.mysql.*) ---
# Required only when audit.mysql.enabled: true. MariaDB or MySQL 5.7+.
ZT_AUDIT_MYSQL_PASSWORD=root_pw

# --- DB-driven data-plane routing (configs/control.yaml routing.*) ---
# Optional: mint-time data-server selection from the data_plane_routes table
# (color + least-loaded; docs/11-node-integration.md §11.13). The lookup DB
# is the AUDIT block when audit.mysql.enabled — then no routing password is
# needed. Required only with a DEDICATED routing.mysql block.
# ZT_ROUTING_ENABLED=true
# ZT_ROUTING_COLOR=blue
# ZT_ROUTING_MYSQL_PASSWORD=root_pw

# --- Data plane backend credentials (configs/data.yaml credentials) ---
# Each committed entry's password is the ${VAR} placeholder expanded from
# this list. Values below match the RUN.md §1 dev container seeds.
ZT_CRED_MYSQL_RO_PASSWORD=ro_pw
ZT_CRED_MYSQL_RW_PASSWORD=rw_pw
ZT_CRED_PG_RO_PASSWORD=ro_pw
ZT_CRED_MSSQL_RO_PASSWORD=ro_pw
ZT_CRED_MSSQL_RW_PASSWORD=rw_pw
# Task 9.14 Oracle (oracle-test container :1521)
ZT_CRED_ORACLE_RO_PASSWORD=ro_pw
ZT_CRED_ORACLE_RW_PASSWORD=rw_pw
# Data-plane vault key (configs/data.yaml credentials_api.api_key) — sent as
# X-Api-Key to the vault endpoint when credentials_source: api. This is the
# DATA plane's key, distinct from the retired control-plane ZT_API_API_KEY.
# ZT_CREDENTIALS_API_API_KEY=vault-key
# ZT_CREDENTIALS_API_URL=http://127.0.0.1:9000/creds   # required when source=api

# --- Valkey (both planes; the committed configs leave these empty) ---
ZT_VALKEY_PASSWORD=
ZT_VALKEY_SENTINEL_PASSWORD=

# --- Optional overrides ---
# ZT_ENV_FILE=/abs/path/to/.env     # load a different env file
# ZT_LOG_LEVEL=debug
# ZT_GATE_WAIT_SECONDS=20
# ZT_METRICS_ENABLED=false
# ZT_API_TOKEN_MAX_USES=4           # token connection budget (config api.token_max_uses; alias ZT_TOKEN_MAX_USES)
# ZT_API_TOKEN_MODE=session         # default token flavor: single-use | session (config api.token_mode)
# ZT_API_SESSION_TOKEN_TTL_SECONDS=0  # session-token lifetime; 0 = INFINITE (revoke by deleting the key)
# ZT_API_MAX_SESSION_SECONDS=0       # ceiling on a mint's end_time; 0 = uncapped (node-integration Task 2)
# ZT_SESSION_IDLE_SECONDS=1800      # data-plane idle timeout for session tokens; 0 = off
# ZT_SESSION_MAX_LIFETIME_SECONDS=0 # data-plane hard cap on session duration; 0 = off
# ZT_SESSION_REVOKE_POLL_SECONDS=1  # token-liveness poll; deletion closes sessions within this
# --- Configurable SoD (node-integration Task 7; UAT single-person setups) ---
# ZT_AUTH_ALLOW_CHECKER_WRITE=false # control: checker may mint write/rw (default false = strict SoD)
# ZT_RW_REQUIRE_CHECKER_WATCH=true  # data: false = rw admits immediately, no checker hold (default true; oracle rw stays refused)
# --- Session-status callbacks (node-integration Task 3; configs/data.yaml session_callback) ---
# Point the data plane at the main application to report Maker session
# start/end: POST {url}/dbpxy/session/{sessionId}/status, body
# {"action":"started"|"ended","timestamp":"<RFC3339 UTC>"}, header
# X-Session-Callback-Key when a shared secret is set. Leave
# ZT_SESSION_CALLBACK_URL unset (or empty) to keep the feature DISABLED.
# ZT_SESSION_CALLBACK_URL=http://127.0.0.1:8080   # the main application's base URL
# ZT_SESSION_CALLBACK_SHARED_SECRET=change-me-to-a-long-random-string-0123456789
# ZT_SESSION_CALLBACK_TIMEOUT_SECONDS=5           # per-attempt HTTP timeout

# --- Control-plane native TLS (configs/control.yaml http.tls) ---
# PATHS to a cert/key pair — NOT secrets, nothing to generate here beyond
# running:  bash scripts/gen-dev-cert.sh  (writes scripts/dev-cert/, git-ignored).
# When BOTH are set the control plane serves HTTPS/WSS on http.addr directly
# (browsers on an https-served SPA then speak wss to this process); NEITHER
# set = plain HTTP (the default); EXACTLY ONE = the plane refuses to start.
# These env vars beat the http.tls block in control.yaml.
# ZT_HTTP_TLS_CERT=scripts/dev-cert/localhost.crt
# ZT_HTTP_TLS_KEY=scripts/dev-cert/localhost.key
